{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": { "api/send-tickets.js": { "maxDuration": 60 } },
  "crons": [{ "path": "/api/send-tickets", "schedule": "0 6 * * *" }],
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/checkin", "destination": "/checkin.html" },
    { "source": "/cancel", "destination": "/cancel.html" },
    { "source": "/ticket", "destination": "/ticket.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ]
}
